APP_NAME=CreatorzHive
# Full public base URL (no trailing slash). Path is used for links, assets, and emails.
# Example subdirectory install: http://localhost/creatorzhive
APP_URL=http://localhost/creatorzhive
# Optional: if APP_URL has no path segment, set the URL prefix here instead (no slashes), e.g. creatorzhive
# APP_BASE_PATH=creatorzhive
# Upload URLs: auto = detect from DOCUMENT_ROOT vs public/ (default). Force 1 if avatars 404.
# APP_UPLOADS_PUBLIC_PREFIX=auto
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=creatorz_hive
# Optional: PHPUnit and CI use this when set; otherwise tests use DB_DATABASE above.
# DB_DATABASE_TEST=creatorz_hive_test
DB_USERNAME=root
DB_PASSWORD=

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@creatorzhive.com
MAIL_FROM_NAME=CreatorzHive

# Gmail SMTP example (use an App Password, not your account password):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourgmail@gmail.com
# MAIL_PASSWORD=your_16_char_app_password
# MAIL_FROM_ADDRESS=yourgmail@gmail.com
# MAIL_FROM_NAME=CreatorzHive

SESSION_LIFETIME=120
SESSION_SECURE=false

# Background Job Processing (InfinityFree/Shared Hosting)
# Use external cron service (UptimeRobot, EasyCron, etc.) to trigger webhook
# Webhook URL: {APP_URL}/?route=webhook/process-jobs.php?secret=WEBHOOK_SECRET
# Generate a random value: php -r 'echo bin2hex(random_bytes(32));'
WEBHOOK_SECRET=dev-secret-key-change-in-production

# Setup endpoint security (public/setup.php one-time deployment wizard)
# Default: only allows localhost (127.0.0.1, ::1)
# For InfinityFree: set to '*' to allow from any IP during setup, then delete setup.php after
# Or: set to comma-separated IP list (e.g., SETUP_ALLOWED_IPS=1.2.3.4,5.6.7.8)
# IMPORTANT: Delete setup.php from server after first-time setup for security!
SETUP_ALLOWED_IPS=

# Encrypts platform API secrets (file) and social_accounts tokens (DB). Required in production.
APP_SECRET=

# Instagram Business Login (Meta Graph API v25) — also configurable in Admin → Settings → Integrations
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match Meta app → Instagram Business Login → Valid OAuth Redirect URIs (defaults to APP_URL/?route=instagram-callback)
# INSTAGRAM_OAUTH_REDIRECT_URI=

# Optional: comma-separated allowed browser Origins for JSON API CORS (exact match). Empty = off.
# API_CORS_ORIGINS=https://app.example.com,http://localhost:5173

# Social APIs — also configurable in Admin → Settings → Integrations (encrypted UI storage)
# Keep SOCIAL_API_MOCK_FALLBACK=true in development to avoid hard failures when a token is missing.
SOCIAL_API_MOCK_FALLBACK=true
SOCIAL_FALLBACK_IMAGE_URL=

# Instagram Business Login — long-lived token (also stored encrypted via Admin → Integrations)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# YouTube / Google OAuth
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY_STATUS=private
# OAuth 2.0 Web client (Sign in with Google + YouTube token refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; default is {APP_URL}{base_path}/?route=google-callback
# GOOGLE_AUTH_REDIRECT_URI=

# X (Twitter)
TWITTER_BEARER_TOKEN=
