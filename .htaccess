# Prefer the app over a bare directory listing when the docroot is this folder.
DirectoryIndex index.php index.html

# Hide directory listings (omit if your host forbids Options in .htaccess).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block sensitive paths (works for subdirectory installs, e.g. /creatorzhive/backend/…).
    RewriteRule (^|/)\.env$ - [F,L,NC]
    RewriteRule ^(backend|database|vendor|scripts|tests|\.git)(/|$) - [F,L,NC]

    # Allow requests already in /public directory to pass through
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Route static files and directories to /public if they exist there
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond /public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ /public/$1 [L]

    # Route requests that don't exist in root to /public/index.php (for web interface)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /public/index.php [L]
</IfModule>
